# .env.example — copie para .env e preencha com suas credenciais
# O arquivo .env NUNCA deve ser versionado (está no .gitignore).

# ============================================================
# Backend LLM (padrão: anthropic)
# Opções: "anthropic" | "openai"
# Use "openai" para Ollama local, RunPod, Together AI e outros
# servidores compatíveis com a API OpenAI (/v1/chat/completions)
# ============================================================
# SYNESIS_CODER_BACKEND=anthropic

# ============================================================
# Backend Anthropic (requerido quando BACKEND=anthropic)
# ============================================================

# Obrigatório quando usando backend Anthropic:
# Obtenha em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-SUBSTITUA_PELA_SUA_CHAVE

# ============================================================
# Backend OpenAI-compatível (requerido quando BACKEND=openai)
# ============================================================

# URL base do servidor (padrão: Ollama local)
# Ollama local: http://localhost:11434
# RunPod:       https://api.runpod.ai/v2/SEU_ENDPOINT/openai
# SYNESIS_CODER_API_URL=http://localhost:11434

# API key para servidores remotos (RunPod, Together AI, etc.)
# Ollama local não exige chave — o valor padrão "no-key-required" é aceito
# SYNESIS_CODER_API_KEY=SEU_TOKEN_AQUI

# ============================================================
# Configurações gerais (aplicam a ambos os backends)
# ============================================================

# Modelo a usar (padrão: claude-opus-4-6 para Anthropic)
# Modelos Anthropic suportados:
#   claude-opus-4-6   — padrão estável
#   claude-opus-4-7   — mais recente; recomendado com THINKING_BUDGET=8000
#   claude-sonnet-4-6 — equilíbrio custo/qualidade; suporta thinking
#   claude-haiku-4-5  — mais rápido/barato; NÃO suporta thinking
# Exemplos locais (backend openai): qwen3:8b, gemma4:e4b, gemma3:4b
# ⚠ Modelos locais NÃO suportam SYNESIS_CODER_THINKING_BUDGET (ignorado com aviso)
# SYNESIS_CODER_MODEL=claude-opus-4-6

# Número máximo de tentativas de correção por LLM (padrão: 3)
# SYNESIS_CODER_MAX_RETRIES=3

# Temperatura do modelo (padrão: 0 — determinístico)
# SYNESIS_CODER_TEMPERATURE=0

# ============================================================
# Rate limiting — apenas backend Anthropic (ignorado em OpenAI)
# ============================================================

# SYNESIS_CODER_MAX_RPM=50
# SYNESIS_CODER_MAX_INPUT_TPM=40000
# SYNESIS_CODER_MAX_OUTPUT_TPM=8000

# ============================================================
# Extended Thinking — apenas backend Anthropic, modelos Claude 4.x
# Ativa raciocínio interno antes da resposta (melhora precisão causal)
# ⚠ Requer modelo compatível: claude-opus-4-7, claude-opus-4-6, claude-sonnet-4-6+
# ⚠ Tokens de thinking são faturados como output tokens (aumenta custo)
# ⚠ Temperatura é forçada a 1.0 internamente quando thinking ativo
# ⚠ Não tem efeito com backends OpenAI-compatíveis (Ollama, RunPod, etc.)
#
# Valores recomendados:
#   0     — desabilitado (padrão; comportamento idêntico ao v0.1.x)
#   4000  — leve: abstracts simples, templates com ≤ 2 campos com GUIDELINES
#   8000  — médio: templates complexos com CHAIN + NOTE (ex: face85) ← RECOMENDADO
#   16000 — pesado: modo ontology em projetos com > 100 códigos
# ============================================================
# SYNESIS_CODER_THINKING_BUDGET=0

# ============================================================
# Pipeline ACT — modelos por fase (critique / normalize / incorporate)
# Cada fase pode usar um modelo diferente. Se a variável específica
# da fase não estiver definida, o fallback é SYNESIS_CODER_MODEL.
# ============================================================

# Fase 2 — Critique (avalia fidelidade das anotações ao texto-fonte)
# Modelos recomendados: claude-sonnet-4-6, gemini-flash, gpt-4o-mini
# SYNESIS_CODER_CRITIQUE_MODEL=claude-sonnet-4-6

# Fase 3 — Normalize (canonicaliza códigos cross-corpus)
# Modelos recomendados: qwen3:14b (Ollama local), gemma3, gpt-4o-mini
# SYNESIS_CODER_NORMALIZATION_MODEL=qwen3:14b

# Fase 4 — Incorporate (determinístico — sem LLM, nenhuma variável necessária)

# Fase R — Refine (re-extração com feedback, opt-in — subcomando `refine`)
# Ao contrário do incorporate, o gerador reescreve o ITEM ciente do erro apontado
# pelo crítico (padrão Self-Refine). Crítico != gerador para independência epistêmica:
# o crítico reusa SYNESIS_CODER_CRITIQUE_MODEL; o gerador usa a variável abaixo.
# Modelos recomendados p/ gerador: claude-opus-4-6 (fallback: SYNESIS_CODER_MODEL)
# SYNESIS_CODER_REFINE_MODEL=claude-opus-4-6
# Teto de iterações por ITEM (padrão: 2; literatura mostra retornos decrescentes após 2-3)
# Sobrescrevível por --max-iter na CLI
# SYNESIS_CODER_REFINE_MAX_ITER=2
# (limiar de convergência reusa SYNESIS_CODER_SUSPICION_THRESHOLD abaixo)

# Limiar de suspeição da Fase 2 (padrão: 0.20)
# ITEMs com suspicion_score >= threshold recebem bloco # REVISION no .synr
# Valores típicos: 0.20 (liberal, flageia mais) a 0.50 (conservador, apenas casos claros)
# Sobrescrevível por --threshold na CLI
# SYNESIS_CODER_SUSPICION_THRESHOLD=0.20

# Limiar de confiança da Fase 3 (padrão: 0.65)
# Sugestões LLM com merge_confidence < threshold são descartadas
# Sobrescrevível por --confidence na CLI
# SYNESIS_CODER_MERGE_CONFIDENCE_THRESHOLD=0.65
